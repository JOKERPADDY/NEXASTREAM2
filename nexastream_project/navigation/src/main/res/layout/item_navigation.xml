<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_navigation_item"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_item"
    android:duplicateParentState="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/iv_navigation_item_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:tint="@color/navigation_item_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tv_navigation_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/navigation_item_tint"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_navigation_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="HOME" />

</androidx.constraintlayout.widget.ConstraintLayout>
