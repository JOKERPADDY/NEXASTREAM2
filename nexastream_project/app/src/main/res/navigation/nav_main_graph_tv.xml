<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main_graph_tv"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/providers"
        android:name="com.nexastream.app.fragments.providers.ProvidersTvFragment"
        android:label="fragment_providers_tv"
        tools:layout="@layout/fragment_providers_tv">
        <action
            android:id="@+id/action_providers_to_home"
            app:destination="@id/home" />
    </fragment>

    <!-- Global Actions -->
    <action
        android:id="@+id/action_global_providers"
        app:destination="@id/providers" />
    <action
        android:id="@+id/action_global_player"
        app:destination="@id/player" />
    <action
        android:id="@+id/action_global_tv_show"
        app:destination="@id/tv_show" />
    <action
        android:id="@+id/action_global_movie"
        app:destination="@id/movie" />
    <action
        android:id="@+id/action_global_sports_servers"
        app:destination="@id/sports_servers" />

    <fragment
        android:id="@+id/home"
        android:name="com.nexastream.app.fragments.home.HomeTvFragment"
        android:label="fragment_home_tv"
        tools:layout="@layout/fragment_home_tv">
        <action
            android:id="@+id/action_home_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_home_to_tv_show"
            app:destination="@id/tv_show" />
        <action
            android:id="@+id/action_home_to_genre"
            app:destination="@id/genre" />
    </fragment>
    <fragment
        android:id="@+id/search"
        android:name="com.nexastream.app.fragments.search.SearchTvFragment"
        android:label="fragment_search_tv"
        tools:layout="@layout/fragment_search_tv">
        <action
            android:id="@+id/action_search_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_search_to_tv_show"
            app:destination="@id/tv_show" />
        <action
            android:id="@+id/action_search_to_people"
            app:destination="@id/people" />
        <action
            android:id="@+id/action_search_to_genre"
            app:destination="@id/genre" />
    </fragment>
    <fragment
        android:id="@+id/movies"
        android:name="com.nexastream.app.fragments.movies.MoviesTvFragment"
        android:label="fragment_movies_tv"
        tools:layout="@layout/fragment_movies_tv">
        <action
            android:id="@+id/action_movies_to_movie"
            app:destination="@id/movie" />
    </fragment>
    <fragment
        android:id="@+id/tv_shows"
        android:name="com.nexastream.app.fragments.tv_shows.TvShowsTvFragment"
        android:label="fragment_tv_shows_tv"
        tools:layout="@layout/fragment_tv_shows_tv">
        <action
            android:id="@+id/action_tv_shows_to_tv_show"
            app:destination="@id/tv_show" />
    </fragment>
    <fragment
        android:id="@+id/movie"
        android:name="com.nexastream.app.fragments.movie.MovieTvFragment"
        android:label="fragment_movie_tv"
        tools:layout="@layout/fragment_movie_tv">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_movie_to_player"
            app:destination="@id/player" />
        <action
            android:id="@+id/action_movie_to_people"
            app:destination="@id/people" />
        <action
            android:id="@+id/action_movie_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_movie_to_tv_show"
            app:destination="@id/tv_show" />
    </fragment>
    <fragment
        android:id="@+id/tv_show"
        android:name="com.nexastream.app.fragments.tv_show.TvShowTvFragment"
        android:label="fragment_tv_show_tv"
        tools:layout="@layout/fragment_tv_show_tv">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="poster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="banner"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_tv_show_to_season"
            app:destination="@id/season" />
        <action
            android:id="@+id/action_tv_show_to_people"
            app:destination="@id/people" />
        <action
            android:id="@+id/action_tv_show_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_tv_show_to_tv_show"
            app:destination="@id/tv_show" />
        <action
            android:id="@+id/action_tv_show_to_player"
            app:destination="@id/player" />
    </fragment>
    <fragment
        android:id="@+id/season"
        android:name="com.nexastream.app.fragments.season.SeasonTvFragment"
        android:label="fragment_season_tv"
        tools:layout="@layout/fragment_season_tv">
        <action
            android:id="@+id/action_season_to_player"
            app:destination="@id/player" />
        <argument
            android:name="tvShowId"
            app:argType="string" />
        <argument
            android:name="tvShowTitle"
            app:argType="string" />
        <argument
            android:name="tvShowPoster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tvShowBanner"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="seasonId"
            app:argType="string" />
        <argument
            android:name="seasonNumber"
            app:argType="integer" />
        <argument
            android:name="seasonTitle"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/genre"
        android:name="com.nexastream.app.fragments.genre.GenreTvFragment"
        android:label="fragment_genre_tv"
        tools:layout="@layout/fragment_genre_tv">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="name"
            app:argType="string" />
        <action
            android:id="@+id/action_genre_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_genre_to_tv_show"
            app:destination="@id/tv_show" />
    </fragment>
    <fragment
        android:id="@+id/people"
        android:name="com.nexastream.app.fragments.people.PeopleTvFragment"
        android:label="fragment_people_tv"
        tools:layout="@layout/fragment_people_tv">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_people_to_movie"
            app:destination="@id/movie" />
        <action
            android:id="@+id/action_people_to_tv_show"
            app:destination="@id/tv_show" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="image"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/player"
        android:name="com.nexastream.app.fragments.player.PlayerTvFragment"
        android:label="fragment_player_tv"
        tools:layout="@layout/fragment_player_tv">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="subtitle"
            app:argType="string" />
        <argument
            android:name="videoType"
            app:argType="com.nexastream.app.models.Video$Type" />
        <argument
            android:name="serverId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_playerTvFragment_self"
            app:destination="@id/player"
            app:popUpTo="@id/player"
            app:popUpToInclusive="true" />
    </fragment>

    <dialog
        android:id="@+id/sports_servers"
        android:name="com.nexastream.app.fragments.player.SportsServersDialogFragment"
        android:label="SportsServersDialogFragment">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="subtitle"
            app:argType="string" />
        <argument
            android:name="videoType"
            app:argType="com.nexastream.app.models.Video$Type" />
    </dialog>
    <fragment
        android:id="@+id/settings"
        android:name="com.nexastream.app.fragments.settings.SettingsTvFragment"
        android:label="fragment_settings_tv">
        <action
            android:id="@+id/action_settings_to_speed_test"
            app:destination="@id/speed_test" />
    </fragment>

    <fragment
        android:id="@+id/speed_test"
        android:name="com.nexastream.app.fragments.settings.SpeedTestTvFragment"
        android:label="fragment_speed_test_tv"
        tools:layout="@layout/fragment_speed_test_tv" />

    <fragment
        android:id="@id/downloads"
        android:name="com.nexastream.app.fragments.downloads.DownloadsFragment"
        android:label="fragment_downloads">
        <action
            android:id="@id/action_downloads_to_player"
            app:destination="@id/player" />
    </fragment>
    <fragment
        android:id="@+id/live_guide"
        android:name="com.nexastream.app.fragments.live_guide.LiveGuideFragment"
        android:label="@string/main_menu_live_guide" />

    <fragment
        android:id="@+id/qr_login"
        android:name="com.nexastream.app.fragments.login.TvQrLoginFragment"
        android:label="QR Login"
        tools:layout="@layout/fragment_tv_qr_login" />
</navigation>
