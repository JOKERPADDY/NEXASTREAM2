<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_tv_show_tv"
    android:padding="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- CardView for 16:9 Episode Thumbnail -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_episode_thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_episode_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_item_episode_image_tv"
                android:foreground="@drawable/fg_item_episode_image_tv"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:src="@drawable/glide_fallback_cover" />

            <ProgressBar
                android:id="@+id/pb_episode_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:backgroundTint="#CC646464"
                android:progressTint="#E50914"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/iv_selection_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="8dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/netflix_red"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Episode Number Info -->
    <TextView
        android:id="@+id/tv_episode_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_episode_thumbnail"
        tools:text="Episode 1" />

    <!-- Episode Title (Max 2 lines, truncated with ellipsis) -->
    <TextView
        android:id="@+id/tv_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_info"
        tools:text="The First Cut is the Deepest" />

    <!-- Release Date -->
    <TextView
        android:id="@+id/tv_episode_released"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/btn_episode_download"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_title"
        tools:text="Sunday - March 27, 2005" />

    <!-- Download Button (Optional) -->
    <ImageView
        android:id="@+id/btn_episode_download"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:focusable="true"
        android:padding="2dp"
        android:src="@drawable/ic_download"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_episode_released"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_episode_released"
        app:tint="#FFFFFF"
        tools:ignore="ContentDescription" />

    <!-- Hidden Overview to maintain binding compatibility -->
    <TextView
        android:id="@+id/tv_episode_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_released" />

</androidx.constraintlayout.widget.ConstraintLayout>