<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state (Selected or Unselected) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="@color/netflix_red" />
        </shape>
    </item>

    <!-- Active/Selected state when unfocused -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/netflix_red" />
        </shape>
    </item>

    <!-- Default normal state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#262626" />
            <stroke android:width="1dp" android:color="#3A3A3A" />
        </shape>
    </item>

</selector>
